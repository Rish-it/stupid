# Secnd server settings. Read by the server at startup; never `source` this file.

# Meta app (developers.facebook.com → your app). Facebook Login for Business configuration id.
SECND_META_APP_ID=
SECND_META_APP_SECRET=
SECND_META_LOGIN_CONFIG_ID=
# The address people open. https:// turns on __Host- cookies and allows writes only from this origin.
SECND_META_PUBLIC_URL=http://localhost:8000
SECND_META_REDIRECT_URI=http://localhost:8000/api/v1/meta/oauth/callback
# Any long random string; enter the same value in Meta's webhook settings.
SECND_META_VERIFY_TOKEN=
# Encrypts stored Meta tokens. Create one with: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECND_META_TOKEN_KEY=
SECND_META_GRAPH_VERSION=v25.0

# Agents on Muse Spark Open. Spend stops at the budget; people can also add their own key in Settings.
SECND_MUSE_API_KEY=
SECND_MUSE_BASE_URL=https://inference.baseten.co/v1
SECND_MUSE_MODEL=meta-models/muse-spark-open-1026
SECND_MUSE_BUDGET_USD=10

# Where the server listens, keeps its database and finds the built frontend.
SECND_BIND=127.0.0.1:8000
SECND_DATA_DIR=.data/server
SECND_STATIC_DIR=frontend/dist
