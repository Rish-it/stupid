# Stupid server settings. Read by the server at startup; never `source` this file.

# Meta app (developers.facebook.com → your app). Facebook Login for Business configuration id.
STUPID_META_APP_ID=
STUPID_META_APP_SECRET=
STUPID_META_LOGIN_CONFIG_ID=
# The address people open. https:// turns on __Host- cookies and allows writes only from this origin.
STUPID_META_PUBLIC_URL=http://localhost:8000
STUPID_META_REDIRECT_URI=http://localhost:8000/api/v1/meta/oauth/callback
# Any long random string; enter the same value in Meta's webhook settings.
STUPID_META_VERIFY_TOKEN=
# Encrypts stored Meta tokens. Create one with: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
STUPID_META_TOKEN_KEY=
STUPID_META_GRAPH_VERSION=v25.0

# Agents on Muse Spark Open. Spend stops at the budget; people can also add their own key in Settings.
STUPID_MUSE_API_KEY=
STUPID_MUSE_BASE_URL=https://inference.baseten.co/v1
STUPID_MUSE_MODEL=meta-models/muse-spark-open-1026
STUPID_MUSE_BUDGET_USD=10

# Meta Model API (api.meta.ai): Muse Voice Transcribe, Muse Wonder and SAM 3.1, under their own budget.
# Never a -contributor model, and never Muse Image (barred in India).
STUPID_META_API_KEY=
STUPID_META_API_BUDGET_USD=20

# Where the server listens, keeps its database and finds the built frontend.
STUPID_BIND=127.0.0.1:8000
STUPID_DATA_DIR=.data/server
STUPID_STATIC_DIR=frontend/dist
